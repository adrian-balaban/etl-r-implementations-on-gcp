DESCRIPTION Change in flight and constant change: a new transform through config, stressors S1–S6 (K05, K15)
CATEGORY Engineering Practices
NAMESPACE EtlRStyleNS
DEFINE SYSTEM ETL-R AS etl-r-implementations-on-gcp
     DEFINE CONST MAX_ENDPOINTS AS 10
     DEFINE SERVICE flink AS implementations/flink
     DEFINE SERVICE flink-jdbc AS implementations/flink-jdbc
     DEFINE SERVICE beam-dataflow AS implementations/beam-dataflow
     DEFINE MAPPING ProjectMapping AS spec/contracts/mappings/
     DEFINE SCHEMA TargetSchema AS spec/contracts/schemas/target-account.schema.json

# A new transform (e.g. mask_emails) enters through mapping-YAML, not through branch/toggle/new code
ASSERT(mapping.yaml strict where protocol required, permissive otherwise) # [K05-1]
ASSERT(JSON Schema validates target document structure) # [K05-2]
ASSERT(no endpoint supports more than MAX_ENDPOINTS message versions) # [K05-3]
# Anti-tautology: a test that asserts nothing is not a fitness function
ASSERT(FOREACH TEST t IN all tests DO ASSERT(t contains at least one assertion) END) # [K05-4]
ASSERT(FOREACH ASSERT a IN test DO ASSERT(a is not tautology) END) # [K05-5]

# The residues for the stressors (K15): contracts-as-config, a pinned oracle, an abstract stage mapping
ASSERT(adding a project modifies only spec/contracts/) # [K15-1]
ASSERT(manifest.json sha256 pinned: ACCOUNT.src unchanged) # [K15-2]
ASSERT(stage mapping abstract: 08-stage-mapping.svg unchanged modulo visual additions) # [K15-3]